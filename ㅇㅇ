<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <title>IRONFORGE ADMIN | 내부 관리 시스템</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "Pretendard", "Segoe UI", sans-serif;
      background: #020617;
      color: #e5e7eb;
      height: 100vh;
      overflow: hidden;
    }

    /* ---------- LOGIN ---------- */
    .login-screen {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100vh;
      background: radial-gradient(circle at top, #1e293b, #020617);
    }

    .login-box {
      background: #020617;
      border: 1px solid #1e293b;
      padding: 40px;
      width: 360px;
      border-radius: 12px;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0,0,0,.5);
    }

    .login-box h1 {
      font-size: 1.5rem;
      margin-bottom: 8px;
    }

    .login-box p {
      font-size: .9rem;
      color: #94a3b8;
      margin-bottom: 24px;
    }

    .login-box input {
      width: 100%;
      padding: 10px 12px;
      margin-bottom: 12px;
      border-radius: 6px;
      border: 1px solid #334155;
      background: #020617;
      color: #fff;
    }

    .login-box button {
      width: 100%;
      padding: 10px;
      background: #2563eb;
      border: none;
      border-radius: 6px;
      color: #fff;
      cursor: pointer;
    }

    /* ---------- DASHBOARD LAYOUT ---------- */
    .dashboard {
      display: none;
      grid-template-columns: 260px 1fr;
      height: 100vh;
    }

    aside {
      background: #020617;
      border-right: 1px solid #1e293b;
      padding: 24px;
    }

    .logo {
      font-weight: 800;
      margin-bottom: 32px;
      letter-spacing: 1px;
    }

    .menu button {
      display: block;
      width: 100%;
      text-align: left;
      padding: 10px 12px;
      margin-bottom: 8px;
      background: transparent;
      border: 1px solid #1e293b;
      border-radius: 6px;
      color: #cbd5f5;
      cursor: pointer;
    }

    .menu button:hover { background: #020617; color: #fff; }

    main {
      padding: 32px;
      overflow-y: auto;
    }

    h2 { margin-bottom: 16px; }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
      margin-bottom: 32px;
    }

    .card {
      background: #020617;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 16px;
    }

    .card h3 { margin-bottom: 6px; font-size: 1rem; }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: .9rem;
    }

    th, td {
      border-bottom: 1px solid #1e293b;
      padding: 8px;
      text-align: left;
    }

    th { color: #94a3b8; }

    .tag {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 12px;
      font-size: .75rem;
      background: #1e293b;
    }

  </style>
</head>
<body>

<!-- LOGIN SCREEN -->
<div class="login-screen" id="login">
  <div class="login-box">
    <h1>IRONFORGE ADMIN</h1>
    <p>내부 접근 전용 시스템</p>    <input type="password" placeholder="접속 코드" />
    <button onclick="enterSystem()">접속</button>
  </div>
</div>

<!-- DASHBOARD -->
<div class="dashboard" id="dashboard">

  <aside>
    <div class="logo">IRONFORGE</div>
    <div class="menu">
      <button onclick="show('overview')">📊 현황</button>
      <button onclick="show('projects')">🏗 프로젝트</button>
      <button onclick="show('personnel')">👤 인원</button>
      <button onclick="show('security')">🔒 보안</button>
    </div>
  </aside>

  <main>

    <!-- OVERVIEW -->
    <section id="overview">
      <h2>운영 현황</h2>
      <div class="grid">
        <div class="card"><h3>진행 중 공사</h3><p>7건</p></div>
        <div class="card"><h3>보안 등급 S</h3><p>2시설</p></div>
        <div class="card"><h3>가동 마도로</h3><p>93%</p></div>
        <div class="card"><h3>내부 경고</h3><p>1건</p></div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section id="projects" style="display:none">
      <h2>프로젝트 목록</h2>
      <table>
        <tr><th>코드</th><th>위치</th><th>등급</th><th>상태</th></tr>
        <tr><td>XF-112</td><td>북부 요새</td><td>A</td><td><span class="tag">진행중</span></td></tr>
        <tr><td>OB-03</td><td>지하 연구구역</td><td>S</td><td><span class="tag">보안잠금</span></td></tr>
        <tr><td>CT-77</td><td>왕도 외곽</td><td>B</td><td><span class="tag">완료</span></td></tr>
      </table>
    </section>

    <!-- PERSONNEL -->
    <section id="personnel" style="display:none">
      <h2>핵심 인원</h2>
      <div class="grid">
        <div class="card"><h3>총괄감독</h3><p>아르켄 블랙스톤</p></div>
        <div class="card"><h3>보안책임</h3><p>세라 나이트폴</p></div>
        <div class="card"><h3>마도기술</h3><p>엘도르 벨</p></div>
      </div>
    </section>

    <!-- SECURITY -->
    <section id="security" style="display:none">
      <h2>보안 로그</h2>
      <table>
        <tr><th>시간</th><th>구역</th><th>이벤트</th></tr>
        <tr><td>03:42</td><td>OB-03</td><td>비인가 마력 반응 감지</td></tr>
        <tr><td>02:11</td><td>서버홀</td><td>접속 실패 3회</td></tr>
      </table>
    </section>

  </main>
</div>

<script>
  function enterSystem() {
    const passwordInput = document.querySelector('#login input[type="password"]').value;

    if (passwordInput === 'akghfhqk') {
      document.getElementById('login').style.display = 'none';
      document.getElementById('dashboard').style.display = 'grid';
    } else {
      alert('접속 코드가 올바르지 않습니다.');
    }
  }

  function show(id) {
    document.querySelectorAll('main section').forEach(sec => sec.style.display = 'none');
    document.getElementById(id).style.display = 'block';
  }
</script>

</body>
</html>
